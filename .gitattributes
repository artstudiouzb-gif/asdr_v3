# Автоматическая нормализация окончаний строк
* text=auto

# Служебные папки CI/CD и тестов (исключаются при создании ZIP-архива релиза
# через git archive). Перечисляем только то, что в репозитории есть: строка про
# несуществующий путь ничего не исключает и читается как действующая.
/.github export-ignore
/.claude export-ignore
/.agents export-ignore
/tests export-ignore
/playwright-report export-ignore
/test-results export-ignore

# Инструменты разработки и конфигурации линтеров
/composer.json export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/Makefile export-ignore
/phpstan-bootstrap.php export-ignore
/phpstan.neon export-ignore
/phpstan-baseline.neon export-ignore
/playwright.config.js export-ignore
/scripts/build-assets.mjs export-ignore
/scripts/extract-static-inline-styles.mjs export-ignore

# Локальные инструкции и отчёты разработки
/.gitattributes export-ignore
/.gitignore export-ignore
/README.md export-ignore
/SECURITY.md export-ignore
/CLAUDE.md export-ignore
/PRE_RELEASE_TASKS.md export-ignore
/skills-lock.json export-ignore
