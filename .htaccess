# Этот файл нужен ТОЛЬКО если хостинг не позволяет указать document root
# на папку /public (например, дешёвый shared-хостинг, где сайт = корень
# аккаунта). Если вы настраиваете document root на /public в панели
# хостинга или в конфиге веб-сервера — этот файл можно удалить.
#
# Защита реализована правилами mod_rewrite (флаг [F] → 403): в отличие от
# связки «Require all denied на *.php + точечное разрешение точек входа»,
# она одинаково работает на Apache 2.4 и LiteSpeed — на части shared-
# хостингов слияние Require-секций между .htaccess отличается от каноничного
# Apache, и запрет побеждал разрешение, отдавая 403 в том числе установщику.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Адрес с отпечатком (?v=…) метится переменной: кэш «навсегда» ниже
    # получают только такие ответы. Через переменную, а не <If>: <If> в
    # .htaccess поддерживает не каждый сервер (LiteSpeed хостинга), а
    # непонятная директива роняет весь сайт в 500.
    RewriteCond %{QUERY_STRING} (^|&)v= [NC]
    RewriteRule \.(css|js|woff2?|ttf|eot|svg|jpe?g|png|gif|webp|ico)$ - [E=ASSET_VERSIONED:1]

    # Служебные каталоги недоступны напрямую (403 до проксирования в public/).
    RewriteRule ^(app|config|database|storage|templates|tests|docs)(/|$) - [F]

    # Скрытые файлы и каталоги (.git, .env и т.п.); .well-known оставлен для ACME.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F]

    # Любой .php вне public/ запрещён (config/config.php, database/*.php
    # и т.д. не должны исполняться через веб). Исключения: index.php и
    # download.php — виртуальные точки входа в корне: фронт-контроллер
    # public/.htaccess (RewriteBase /) переписывает маршруты на /index.php,
    # а правило проксирования ниже возвращает его в public/.
    RewriteRule ^(?!public/|index\.php$|download\.php$).*\.php$ - [F]

    # Если запрашиваемый jpg/jpeg/png в uploads отсутствует, но есть одноимённый .webp —
    # отдаём webp-файл напрямую (fallback для корня на Hostinger / LiteSpeed).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/public/$1.webp -f
    RewriteRule ^(?:public/)?uploads/public/(.+)\.(jpe?g|png)$ public/uploads/public/$1.webp [T=image/webp,L]

    RewriteRule ^$ public/ [L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Запрет листинга директорий (storage/logs, database и т.п.).
Options -Indexes -MultiViews

<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    # Декодеры сканов PDF.js (JBIG2, JPEG 2000): без типа application/wasm
    # браузер не компилирует модуль потоком.
    AddType application/wasm .wasm
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # «Навсегда» — только адресам с отпечатком; остальное (загрузки в
    # контенте, перезаписанные по тому же адресу) — сутки с перепроверкой.
    <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|jpe?g|png|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
        Header set Cache-Control "public, max-age=31536000, immutable" env=ASSET_VERSIONED
        Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_ASSET_VERSIONED
    </FilesMatch>

    # SVG — документ, а не картинка: открытый напрямую, он исполняет свои
    # скрипты в домене сайта, а статику отдаёт Apache, мимо CSP из PHP.
    # Санитайзер загрузки (Uploader::sanitizeSvgString) — первая линия, эта
    # политика — вторая: в <img> и CSS-маске она ничего не меняет.
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox"
    </FilesMatch>
</IfModule>

# Дампы БД, конфиги, логи, lock-файлы не должны отдаваться как статика.
# Безусловный запрет без исключений — не зависит от порядка слияния секций.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|env|log|lock|ini)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|env|log|lock|ini)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Fallback: если mod_rewrite недоступен, сайт через корень всё равно не
# работает (нет проксирования в public/) — глушим .php полностью, чтобы
# служебные скрипты не исполнялись напрямую.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        <FilesMatch "\.php$">
            Require all denied
        </FilesMatch>
    </IfModule>
    <IfModule !mod_authz_core.c>
        <FilesMatch "\.php$">
            Order allow,deny
            Deny from all
        </FilesMatch>
    </IfModule>
</IfModule>
