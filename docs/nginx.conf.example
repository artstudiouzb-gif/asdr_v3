# ArtStudio CMS — образец конфигурации nginx + PHP-FPM.
# nginx НЕ читает .htaccess: этот файл заменяет правила Apache.
# Скопируйте в /etc/nginx/sites-available/artstudio.conf, поправьте
# server_name, root и путь к сокету PHP-FPM, затем:
#   ln -s ../sites-available/artstudio.conf /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

# TLS-часть здесь опущена намеренно (её выдаёт certbot). Два замечания к ней:
#
#   listen 443 ssl;
#   listen 443 quic reuseport;      # HTTP/3, nginx 1.25+
#   http2 on;
#   add_header Alt-Svc 'h3=":443"; ma=86400' always;   # иначе браузер не узнает про HTTP/3
#
# HTTP/3 полезен ровно тем, ради чего он затевался: потеря пакета не
# останавливает остальные потоки, а это как раз мобильная сеть. Проверять
# так: `curl --http3 -sI https://…` и заголовок alt-svc в обычном ответе.
#
# Ранние подсказки (103 Early Hints) nginx сам не отправляет: PHP-FPM отдаёт
# заголовки вместе с телом. Их превращает в 103 либо Cloudflare (настройка
# «Early Hints» — он запоминает Link: rel=preload с origin), либо Apache с
# `H2EarlyHints on` в конфиге виртуального хоста (в .htaccess эта директива
# запрещена и валит сервер в 500), либо Caddy. Сам заголовок Link печатает
# приложение — App\Core\EarlyHints, до маршрутизации.

server {
    listen 80;
    server_name example.com www.example.com;

    # ВАЖНО: root указывает на папку public/ проекта, а не на его корень.
    # app/, storage/, config/, database/ остаются вне веб-корня и недоступны.
    root /var/www/artstudio/public;
    index index.php;

    charset utf-8;
    client_max_body_size 120m;   # чанковая загрузка файлов в админке

    # Сжатие текстовых ответов (HTML/CSS/JS/JSON/SVG ужимаются в 3–5 раз).
    #
    # Уровень выбирается по типу ответа, а не один на всё. Динамика (HTML
    # страницы) жмётся заново на каждый запрос: 4–5 у gzip и 4 у brotli —
    # почти весь выигрыш при небольшой доле процессора. Статика с
    # ?v=<hash> кэшируется браузером навсегда, её не жаль сжать сильнее, но
    # делать это на лету незачем — для того есть brotli_static/gzip_static с
    # заранее сжатыми файлами. У нас их нет намеренно (см. CLAUDE.md: на
    # Hostinger MultiViews отдавал .br без Content-Encoding, а CDN жал
    # повторно), поэтому уровень один и умеренный.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css text/xml application/json
               application/javascript text/javascript application/xml+rss application/rss+xml
               image/svg+xml application/manifest+json;

    # Если nginx собран с модулем brotli — он предпочтительнее gzip на тех же
    # типах (те же 4–5 % трафика при меньшем размере):
    #   brotli on;
    #   brotli_comp_level 4;      # динамика; 11 — только для заранее сжатых файлов
    #   brotli_types <тот же список, что в gzip_types>;
    # Zstd (ngx_brotli-подобный модуль zstd) браузеры в Accept-Encoding пока
    # объявляют выборочно: включать имеет смысл только рядом с brotli, а не
    # вместо него.

    # Безопасные заголовки (дублируют SecurityHeaders приложения — не мешает).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Скрытые файлы (.git, .htaccess и т.п.) не отдаются.
    location ~ /\. { deny all; }

    # Служебные расширения не отдаются как статика.
    location ~* \.(sql|log|lock|ini|env)$ { deny all; }

    # Версионированные ассеты (?v=hash) кэшируются надолго.
    location ~* \.(css|js|woff2?|ttf|eot|svg|jpe?g|png|gif|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Единственные исполняемые PHP — точки входа приложения.
    # Точные location (=) имеют приоритет над регулярным запретом ниже.
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;  # поправьте под свою версию PHP
    }
    location = /download.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/download.php;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    # Любые прочие .php (в т.ч. в /uploads) не исполняются и не отдаются.
    location ~ \.php$ { return 404; }

    # Всё остальное — статика напрямую либо роутер приложения.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
