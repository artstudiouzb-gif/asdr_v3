{
  ".image-field": {
    "backgroundColor": "rgb(255, 255, 255)",
    "borderColor": "rgb(220, 220, 222)",
    "borderRadius": "3px",
    "padding": "12px 14px"
  },
  ".image-field > label": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "13px",
    "fontWeight": "600",
    "marginBottom": "9px"
  },
  ".image-field__row": {
    "display": "flex",
    "gap": "14px",
    "alignItems": "flex-start"
  },
  ".image-field__preview": {
    "width": "132px",
    "height": "84px",
    "borderColor": "rgb(220, 220, 222)",
    "borderRadius": "3px",
    "backgroundColor": "rgb(250, 251, 252)"
  },
  ".image-field__name": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "13px",
    "fontWeight": "500"
  },
  ".image-field__controls": {
    "display": "flex",
    "gap": "6px",
    "flexWrap": "wrap"
  },
  ".image-field__url": {
    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "height": "38px",
    "borderRadius": "3px"
  }
}
