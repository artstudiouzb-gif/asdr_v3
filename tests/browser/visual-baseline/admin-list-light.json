{
  ".data-table": {
    "backgroundColor": "rgb(255, 255, 255)",
    "borderColor": "rgb(220, 220, 222)"
  },
  ".data-table th": {
    "backgroundColor": "rgb(250, 251, 252)",
    "color": "rgb(29, 35, 39)",
    "fontSize": "12px",
    "fontWeight": "600",
    "padding": "12px 16px",
    "borderBottomColor": "rgb(220, 220, 222)"
  },
  ".data-table td": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "13px",
    "padding": "12px 16px",
    "borderBottomColor": "rgb(220, 220, 222)"
  },
  ".data-table tbody tr:nth-child(even)": {
    "backgroundColor": "color(srgb 0.973412 0.974118 0.974588)"
  },
  ".badge": {
    "backgroundColor": "rgb(241, 245, 249)",
    "color": "rgb(71, 85, 105)",
    "borderRadius": "3px",
    "fontSize": "12px",
    "padding": "3px 8px"
  },
  ".list-filters--panel": {
    "backgroundColor": "rgb(255, 255, 255)",
    "borderColor": "rgb(220, 220, 222)",
    "padding": "18px 22px"
  },
  ".list-filter label": {
    "color": "rgb(100, 105, 112)",
    "fontSize": "11px",
    "fontWeight": "600"
  },
  ".list-filter input": {
    "backgroundColor": "rgb(255, 255, 255)",
    "color": "rgb(15, 23, 42)",
    "borderColor": "rgb(220, 220, 222)",
    "height": "38px"
  },
  ".bulk-bar": {
    "backgroundColor": "rgb(250, 251, 252)",
    "borderColor": "rgb(220, 220, 222)",
    "padding": "10px 16px"
  },
  ".bulk-bar__count": {
    "color": "rgb(100, 105, 112)",
    "fontSize": "13px"
  },
  ".lang-filter-count": {
    "backgroundColor": "color(srgb 0.929098 0.93098 0.932235)",
    "color": "rgb(100, 105, 112)"
  },
  ".list-filter": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "13px",
    "borderRadius": "0px",
    "padding": "0px"
  },
  ".btn--small": {
    "fontSize": "12px",
    "padding": "0px",
    "borderRadius": "3px",
    "height": "32px",
    "minHeight": "28px"
  },
  ".bulk-bar select": {
    "width": "220px",
    "height": "38px"
  },
  ".bulk-bar .btn": {
    "height": "38px",
    "minHeight": "38px"
  }
}
