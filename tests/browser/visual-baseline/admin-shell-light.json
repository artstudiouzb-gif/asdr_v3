{
  "body": {
    "fontFamily": "\"Noto Sans\", ui-sans-serif, system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "fontSize": "13px",
    "fontWeight": "400"
  },
  ".admin-topbar": {
    "backgroundColor": "rgba(255, 255, 255, 0.97)",
    "color": "rgb(23, 32, 51)",
    "height": "64px",
    "borderBottomColor": "rgba(255, 255, 255, 0.08)"
  },
  ".admin-sidebar": {
    "backgroundColor": "rgb(19, 35, 63)",
    "color": "rgb(232, 238, 248)",
    "width": "286px",
    "borderRightColor": "rgba(255, 255, 255, 0.07)"
  },
  ".admin-nav-item": {
    "color": "rgb(255, 255, 255)",
    "fontSize": "13px",
    "fontWeight": "600",
    "padding": "5px 11px",
    "borderRadius": "3px"
  },
  ".admin-welcome": {
    "backgroundColor": "rgb(255, 255, 255)",
    "borderColor": "rgb(220, 220, 222) rgb(220, 220, 222) rgb(220, 220, 222) rgb(37, 99, 235)",
    "padding": "22px 26px"
  },
  ".admin-welcome h2": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "20px",
    "fontWeight": "600"
  },
  ".admin-welcome p": {
    "color": "rgb(100, 105, 112)",
    "fontSize": "14px"
  },
  ".form-card": {
    "backgroundColor": "rgb(255, 255, 255)",
    "borderColor": "rgb(220, 220, 222)",
    "borderRadius": "3px",
    "boxShadow": "rgba(15, 23, 42, 0.03) 0px 2px 10px 0px",
    "padding": "20px 24px"
  },
  ".stat-card": {
    "backgroundColor": "rgb(255, 255, 255)",
    "borderColor": "rgb(220, 220, 222)",
    "borderRadius": "3px",
    "padding": "18px 20px"
  },
  ".stat-card__value": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "24px",
    "fontWeight": "600"
  },
  ".stat-card__label": {
    "color": "rgb(100, 105, 112)",
    "fontSize": "13px",
    "fontWeight": "500"
  },
  ".badge--small": {
    "padding": "2px 7px",
    "fontSize": "11px",
    "fontWeight": "500",
    "borderRadius": "3px"
  },
  ".btn": {
    "backgroundColor": "rgb(37, 99, 235)",
    "color": "rgb(255, 255, 255)",
    "borderColor": "rgb(37, 99, 235)",
    "borderRadius": "3px",
    "fontSize": "13px",
    "padding": "8px 16px",
    "height": "34px",
    "minHeight": "34px"
  },
  ".btn--primary": {
    "backgroundColor": "rgb(37, 99, 235)",
    "color": "rgb(255, 255, 255)",
    "borderColor": "rgb(37, 99, 235)",
    "borderRadius": "3px",
    "height": "34px"
  }
}
